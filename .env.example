# Copy this file to .env and fill in real values.
# .env is gitignored — .env.example is the template that DOES get committed,
# so anyone cloning the repo knows what variables they need to set.

# Hugging Face access token (needed to download the gated Qualifire dataset)
HF_TOKEN=

# Ollama connection (defaults assume Ollama running locally)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:latest
